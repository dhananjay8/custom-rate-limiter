# Rate Limiter Configuration
RATE_LIMIT_STORAGE=memory  # memory | sqlite | redis
LOG_LEVEL=INFO
APP_ENV=development

# Admin API authentication (optional; if set, required for /admin/*)
ADMIN_TOKEN=

# Dynamic configuration (runtime updates via POST /admin/config)
DYNAMIC_CONFIG_ENABLED=false
DYNAMIC_CONFIG_PATH=dynamic_config.json

# Shadow mode (non-enforcing rate limit preview via X-Shadow-Mode: true header)
SHADOW_MODE_ENABLED=false

# Algorithm Configuration
FOO_ALGORITHM=fixed_window  # fixed_window | sliding_window_log | sliding_window_counter | token_bucket | leaky_bucket | gcra
BAR_ALGORITHM=sliding_window_log

# Client: client-basic
CLIENT_BASIC_FOO_LIMIT=10
CLIENT_BASIC_FOO_WINDOW=60
CLIENT_BASIC_BAR_LIMIT=20
CLIENT_BASIC_BAR_WINDOW=60

# Client: client-premium
CLIENT_PREMIUM_FOO_LIMIT=100
CLIENT_PREMIUM_FOO_WINDOW=60
CLIENT_PREMIUM_BAR_LIMIT=250
CLIENT_PREMIUM_BAR_WINDOW=60

# SQLite Configuration
SQLITE_DB_PATH=rate_limiter.db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=ratelimit:

# Circuit Breaker
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30.0

# Adaptive Rate Limiting
ADAPTIVE_ENABLED=true
ADAPTIVE_SAMPLE_INTERVAL=5.0

# Request Coalescing
COALESCING_ENABLED=true
COALESCING_WINDOW_MS=25.0

# Weighted Operations (cost per HTTP method)
FOO_GET_WEIGHT=1
FOO_POST_WEIGHT=5
BAR_GET_WEIGHT=1
BAR_POST_WEIGHT=3
